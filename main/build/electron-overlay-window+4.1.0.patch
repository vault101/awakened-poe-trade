+bool ow_copy_with_held_ctrl() {
+  CGEventFlags hidFlags =
+      CGEventSourceFlagsState(kCGEventSourceStateHIDSystemState);
+  if ((hidFlags & kCGEventFlagMaskControl) == 0) {
+    return false;
+  }
+
+  CGEventSourceRef src =
+      CGEventSourceCreate(kCGEventSourceStateHIDSystemState);
+  if (!src) {
+    return false;
+  }
+
+  // kVK_ANSI_C = 0x08. Post Ctrl+C without synthesizing a Control keyup
+  // that would clear held modifier state in uiohook / macOS.
+  CGEventRef keyDown = CGEventCreateKeyboardEvent(src, (CGKeyCode)0x08, true);
+  CGEventRef keyUp = CGEventCreateKeyboardEvent(src, (CGKeyCode)0x08, false);
+  if (keyDown && keyUp) {
+    CGEventSetFlags(keyDown, kCGEventFlagMaskControl);
+    CGEventSetFlags(keyUp, kCGEventFlagMaskControl);
+    CGEventPost(kCGHIDEventTap, keyDown);
+    CGEventPost(kCGHIDEventTap, keyUp);
+  }
+  if (keyDown) CFRelease(keyDown);
+  if (keyUp) CFRelease(keyUp);
+  CFRelease(src);
+  return true;
+}
+
+uint32_t ow_get_hid_modifiers() {
+  CGEventFlags hidFlags =
+      CGEventSourceFlagsState(kCGEventSourceStateHIDSystemState);
+  uint32_t mask = 0;
+  if (hidFlags & kCGEventFlagMaskControl) mask |= 1;
+  if (hidFlags & kCGEventFlagMaskAlternate) mask |= 2;
+  if (hidFlags & kCGEventFlagMaskShift) mask |= 4;
+  if (hidFlags & kCGEventFlagMaskCommand) mask |= 8;
+  return mask;
+}
